# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary / intermediate build files
work_bedrock/
temp_*/
*.tmp
*.bak
*.bak.tmp
_backups/

# Heavy binary Minecraft world archives (>50MB limits)
*.zip
*.mcworld
inputs/*.zip
inputs/*.mcworld
!inputs/README.md

# Build output directories (generated locally by map_converter.py)
dist/*
!dist/.gitkeep
packs/*
!packs/.gitkeep

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor folders
.vscode/
.idea/
*.swp

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary / intermediate build files
work_bedrock/
temp_*/
scratch/
*.tmp
*.bak
*.bak.tmp
_backups/

# Heavy binary Minecraft world archives (>50MB limits)
*.zip
*.mcworld
*.mcpack
*.mcaddon
inputs/*.zip
inputs/*.mcworld
input/
!inputs/README.md
!inputs/.gitkeep
expected/*
!expected/README.md
!expected/.gitkeep
extracted/
output/*
!output/.gitkeep

# Temporary packs directory
packs/*
!packs/.gitkeep

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor folders
.vscode/
.idea/
*.swp
